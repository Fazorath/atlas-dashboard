# Atlas secrets. Copy to .env and `chmod 600 .env`.
# Everything that isn't a secret lives in config/ (copy config.example/).

# --- Database ---------------------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_DB=atlas
POSTGRES_PASSWORD=change-me

# --- Host ports ---------------------------------------------------------------
# Loopback by default; put a reverse proxy or `tailscale serve` in front.
# Atlas has no login yet — don't bind it to 0.0.0.0 on an open network.
BIND_ADDRESS=127.0.0.1
API_PORT=8187
WEB_PORT=8188

# Container clocks (logs, cron). Atlas's own "today" is `timezone` in atlas.yaml.
TZ=America/New_York
LOG_LEVEL=info

# --- securo ---------------------------------------------------------------------
SECURO_EMAIL=
SECURO_PASSWORD=

# --- audiobookshelf -------------------------------------------------------------
ABS_TOKEN=

# --- canvas: the feed URL carries its own token ---------------------------------
CANVAS_ICS_URL=

# --- google_health --------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
