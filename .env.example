# Atlas secrets. Copy to .env and `chmod 600 .env`.
# Everything else is set up in the app: open Atlas and follow Setup. It writes
# config/ for you (or edit config/ by hand — config.example/ shows every key).

# --- Database ---------------------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_DB=atlas
# Docker Compose expands "$" in .env values, so a "$" in a password is silently
# mangled. Avoid "$" (e.g. `openssl rand -hex 24`) or wrap the value in single quotes.
POSTGRES_PASSWORD=change-me

# --- Required: Atlas's own key --------------------------------------------------
# Seals the secrets you enter in Setup (a database dump alone reveals none) and
# signs the Owner's unlock cookie. Any random string of 32+ characters:
#   openssl rand -base64 32
# Back it up with .env: losing or changing it means entering those secrets again.
ATLAS_SECRET_KEY=

# --- Host ports ---------------------------------------------------------------
# Loopback by default; put a reverse proxy or `tailscale serve` in front.
# Only the Owner can change settings, but anyone who reaches Atlas can read
# it — don't bind it to 0.0.0.0 on an open network.
BIND_ADDRESS=127.0.0.1
API_PORT=8187
WEB_PORT=8188

# Build atlas-api with OpenCV + Tesseract for reading schedule photos
# (config.example/modules/work.yaml). Rebuild after changing it. true, 1, yes or on
# (any case) turn it on; anything else leaves it off.
WITH_VISION=false

# Container clocks (logs, cron). Atlas's own "today" is `timezone` in atlas.yaml.
TZ=America/New_York
LOG_LEVEL=info

# --- Optional: module secrets -------------------------------------------------
# Usually entered in Setup instead. One set here wins and shows as "Set in .env".

# --- securo ---------------------------------------------------------------------
SECURO_EMAIL=
# If the password contains "$", wrap the whole value in single quotes.
SECURO_PASSWORD=

# --- audiobookshelf -------------------------------------------------------------
ABS_TOKEN=

# --- canvas: the feed URL carries its own token ---------------------------------
CANVAS_ICS_URL=

# --- google_health --------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
