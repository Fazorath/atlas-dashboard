# Atlas configuration. Copy to .env and `chmod 600 .env`.
# Secrets live here only — never inline in docker-compose.yml.

TZ=America/New_York

# --- Database (Phase 1) -----------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_DB=atlas
POSTGRES_PASSWORD=change-me

# --- Host ports, loopback only; tailscale serve --https=8446 is the ingress --
API_PORT=8187
WEB_PORT=8188

LOG_LEVEL=info

# --- Phase 2: weather (Open-Meteo, no API key) ------------------------------
WEATHER_LAT=
WEATHER_LON=

# --- Phase 3: Securo (reached over securo_default) --------------------------
SECURO_BASE_URL=http://backend:8000
SECURO_EMAIL=
SECURO_PASSWORD=
# Optional: blank uses the account's oldest workspace, as Securo's own UI does.
SECURO_WORKSPACE_ID=
# Where your browser reaches Securo, for Money's "open Securo" nudge. Blank
# renders no link.
SECURO_PUBLIC_URL=

# --- Phase 4: Audiobookshelf (reached over nas_default) ---------------------
# Mint in the ABS UI: Settings -> API Keys
ABS_BASE_URL=http://audiobookshelf:80
ABS_TOKEN=
# Where your browser reaches ABS, for the "open in Audiobookshelf" link. Not the
# same as ABS_BASE_URL, which is a docker network name. Blank renders no link.
ABS_PUBLIC_URL=http://your-tailnet-host.ts.net:13378

# --- Phase 6: Canvas (calendar feed, no OAuth) -----------------------------
# Canvas -> Calendar -> Calendar Feed. The URL carries its own token, so treat
# it as a secret; resetting it in Canvas invalidates the old one.
CANVAS_ICS_URL=
# Optional short course names: `fragment=Label` pairs split by `;`. A fragment
# matches anywhere in Canvas's course name, case-insensitive, first match wins.
CANVAS_COURSE_LABELS=CS101=Intro CS;Calculus II=Calc II

# --- Phase 7: Fitbit via Google Health API ---------------------------------
# NOT dev.fitbit.com — that API was turned down September 2026. Google Cloud
# console: enable "Google Health API", create a Web application OAuth client,
# Audience = External + Testing with yourself as a test user, and add the three
# googlehealth.*.readonly scopes (sleep, activity_and_fitness,
# health_metrics_and_measurements). The secret is shown once, at creation.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the client's authorised redirect URI exactly, port included. The
# tailnet URL is the smooth path; if Google won't accept it, register
# http://localhost:8080/oauth/callback instead and paste the address back.
GOOGLE_OAUTH_REDIRECT_URI=https://your-tailnet-host.ts.net:8446/api/sleep/oauth/callback
