.env
*.env.local

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
.ruff_cache/

# node
node_modules/
dist/
*.tsbuildinfo
.astro/
npm-debug.log*

# agent worktrees
.claude/

# editor / os
.DS_Store
.idea/
.vscode/

# local setup — written by Setup, or copied from the *.example versions. The
# committed .gitkeep makes config/ exist on a fresh clone, so Docker never
# creates it root-owned.
/config/*
!/config/.gitkeep
docker-compose.override.yml

# database dumps hold OAuth tokens; keep them outside the repo (/backups/ was the old recipe's folder)
/backups/
*.dump
